    :root{
      --primary:#0f172a;
      --blue:#1d4ed8;
      --sky:#0ea5e9;
      --gold:#f4b942;
      --green:#22c55e;
      --bg:#f4f8ff;
      --card:#ffffff;
      --text:#1d2a39;
      --muted:#5c6b7b;
      --line:rgba(15,23,42,.09);
      --shadow:0 16px 36px rgba(15,23,42,.12);
      --shadow-soft:0 10px 24px rgba(15,23,42,.08);
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
      background:linear-gradient(180deg,#f8fbff 0%, #edf5ff 100%);
      color:var(--text);
      line-height:1.8;
    }
    a{text-decoration:none}
    img{max-width:100%;display:block}

    .container{
      width:min(1200px, calc(100% - 32px));
      margin:0 auto;
    }

    .topbar{
      background:linear-gradient(90deg,#08101a 0%, #11233f 100%);
      color:#fff;
      text-align:center;
      padding:.9rem 1rem;
      font-weight:700;
    }
    .topbar span{
      color:var(--gold);
      margin-left:8px;
    }

    header{
      position:sticky;
      top:0;
      z-index:20;
      background:rgba(15,23,42,.92);
      backdrop-filter:blur(12px);
      border-bottom:1px solid rgba(255,255,255,.07);
    }

    .nav{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      min-height:82px;
      flex-wrap:wrap;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      color:#fff;
    }

    .brand-mark{
      width:48px;height:48px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,var(--sky),var(--blue));
      font-size:1.4rem;
      box-shadow:0 12px 22px rgba(14,165,233,.35);
    }

    .brand h1{
      margin:0;
      font-size:clamp(1.3rem,2vw,2rem);
      line-height:1.2;
    }

    .brand small{
      display:block;
      color:rgba(255,255,255,.72);
      font-size:.72rem;
      margin-top:2px;
    }

    .nav-menu{
      display:flex;
      align-items:center;
      gap:.7rem;
      flex-wrap:wrap;
    }

    .nav-menu a{
      color:rgba(255,255,255,.82);
      font-weight:700;
      padding:.55rem .8rem;
      border-radius:10px;
      transition:.2s ease;
    }

    .nav-menu a:hover{
      background:rgba(255,255,255,.08);
      color:#fff;
    }

    .phone-btn{
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:linear-gradient(135deg,var(--sky),var(--blue));
      color:#fff;
      padding:.82rem 1.1rem;
      border-radius:999px;
      font-weight:800;
      box-shadow:0 14px 26px rgba(14,165,233,.28);
    }

    .hero{
      position:relative;
      padding:3rem 0 2rem;
      overflow:hidden;
    }

    .hero::before{
      content:"";
      position:absolute;inset:0;
      background:
        radial-gradient(circle at 10% 15%, rgba(14,165,233,.18), transparent 18%),
        radial-gradient(circle at 82% 8%, rgba(29,78,216,.12), transparent 20%),
        linear-gradient(135deg, rgba(255,255,255,.4), rgba(232,241,255,.26));
      z-index:0;
    }

    .hero-inner{
      position:relative;
      z-index:1;
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:1.8rem;
      align-items:center;
    }

    .hero-panel{
      background:rgba(255,255,255,.75);
      border:1px solid var(--line);
      border-radius:30px;
      padding:clamp(1.5rem,2vw,2.5rem);
      box-shadow:var(--shadow-soft);
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      background:linear-gradient(135deg, rgba(14,165,233,.14), rgba(29,78,216,.08));
      border:1px solid rgba(29,78,216,.08);
      color:var(--blue);
      font-weight:800;
      padding:.55rem .9rem;
      border-radius:999px;
      margin-bottom:1rem;
    }

    .hero h2{
      margin:0 0 1rem;
      font-size:clamp(2rem,3vw,3.2rem);
      line-height:1.2;
      color:var(--primary);
    }

    .hero p{
      margin:0;
      color:var(--muted);
      font-size:1.05rem;
      max-width:640px;
    }

    .hero-actions{
      margin-top:1.5rem;
      display:flex;
      align-items:center;
      gap:1rem;
      flex-wrap:wrap;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:52px;
      padding:0 1.35rem;
      border-radius:14px;
      font-weight:800;
      border:none;
      cursor:pointer;
      transition:transform .2s ease, box-shadow .2s ease;
    }

    .btn:hover{transform:translateY(-2px)}

    .primary{
      background:linear-gradient(135deg,var(--primary),var(--blue));
      color:#fff;
      box-shadow:0 15px 26px rgba(29,78,216,.22);
    }

    .secondary{
      background:#fff;
      border:1px solid rgba(15,23,42,.12);
      color:var(--primary);
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(120px,1fr));
      gap:1rem;
      margin-top:1.7rem;
    }

    .stat-box{
      background:linear-gradient(135deg,#f5f9ff 0%, #edf5ff 100%);
      border:1px solid rgba(29,78,216,.08);
      border-radius:18px;
      padding:1rem .8rem;
      text-align:center;
      box-shadow:0 8px 18px rgba(29,78,216,.04);
    }

    .stat-box strong{
      display:block;
      font-size:clamp(1.4rem,2vw,2rem);
      color:var(--blue);
    }
    .stat-box span{
      color:var(--muted);
      font-size:.9rem;
    }

    .hero-card{
      background:linear-gradient(135deg,#0f223d 0%, #1f4fb4 45%, #0ea5e9 100%);
      color:#fff;
      box-shadow:var(--shadow);
      border-radius:30px;
      padding:2rem;
      min-height:390px;
      position:relative;
      overflow:hidden;
    }

    .hero-card::before{
      content:"";
      position:absolute;
      width:250px;height:250px;
      border-radius:50%;
      background:rgba(255,255,255,.07);
      top:-60px;right:-35px;
    }
    .hero-card::after{
      content:"";
      position:absolute;
      width:200px;height:200px;
      border-radius:50%;
      background:rgba(255,255,255,.06);
      bottom:-50px;left:-30px;
    }

    .hero-card-content{
      position:relative;
      z-index:1;
      height:100%;
      display:flex;
      flex-direction:column;
      justify-content:center;
      gap:1rem;
    }

    .hero-card h3{
      margin:0;
      font-size:2rem;
      line-height:1.3;
    }

    .mini-list{
      list-style:none;
      margin:0;
      padding:0;
      display:grid;
      gap:.9rem;
    }

    .mini-list li{
      display:flex;
      align-items:center;
      gap:.8rem;
      font-weight:700;
    }

    .mini-list li::before{
      content:"✓";
      width:28px;height:28px;
      display:grid;place-items:center;
      border-radius:50%;
      background:rgba(255,255,255,.12);
      font-weight:900;
    }

    .tag{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      width:fit-content;
      border-radius:12px;
      padding:.75rem 1rem;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.09);
      font-weight:700;
      margin-top:.5rem;
    }

    main{
      padding:2rem 0 4rem;
    }

    .section-head{
      margin:2.2rem 0 1.2rem;
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:1rem;
      flex-wrap:wrap;
    }

    .section-head h3{
      margin:0;
      color:var(--primary);
      font-size:clamp(1.7rem,2vw,2.2rem);
    }

    .section-head span{
      color:var(--muted);
      font-weight:700;
    }

    .lessons-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:1.4rem;
    }

    .lesson-card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius:22px;
      overflow:hidden;
      box-shadow:var(--shadow-soft);
      transition:transform .2s ease, box-shadow .2s ease;
    }

    .lesson-card:hover{
      transform:translateY(-6px);
      box-shadow:0 20px 35px rgba(15,23,42,.12);
    }

    .lesson-top{
      background:linear-gradient(135deg,var(--primary),var(--blue));
      color:#fff;
      font-weight:800;
      padding:1rem 1.1rem;
    }

    .lesson-body{
      padding:1.2rem 1.1rem 1.4rem;
    }

    .lesson-icon{
      width:52px;height:52px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg,#eaf2ff,#dfeeff);
      font-size:1.5rem;
      margin-bottom:.8rem;
    }

    .lesson-body h4{
      margin:0 0 .55rem;
      color:var(--primary);
      font-size:1.2rem;
    }

    .lesson-body p{
      margin:0 0 1rem;
      color:var(--muted);
      font-size:.96rem;
    }

    .lesson-body a{
      display:block;
      width:100%;
      text-align:center;
      background:linear-gradient(135deg,var(--primary),var(--blue));
      color:#fff;
      padding:.8rem 1rem;
      border-radius:12px;
      font-weight:800;
    }

    .feature-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
      gap:1.2rem;
      margin-top:2rem;
    }

    .feature-box{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:1.35rem 1rem;
      box-shadow:var(--shadow-soft);
    }

    .feature-box .icon{
      width:52px;height:52px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg, rgba(14,165,233,.14), rgba(29,78,216,.12));
      color:var(--blue);
      font-size:1.45rem;
      margin-bottom:.8rem;
    }

    .feature-box h4{
      margin:0 0 .5rem;
      color:var(--primary);
    }
    .feature-box p{
      margin:0;
      color:var(--muted);
    }

    .quiz-wrap{
      background:linear-gradient(135deg,#f2f8ff 0%, #edf7ff 100%);
      border:1px solid rgba(29,78,216,.08);
      border-radius:26px;
      padding:clamp(1.2rem,2vw,2rem);
      margin-top:2rem;
      box-shadow:var(--shadow-soft);
    }

    .quiz-board{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:1.2rem;
      margin-top:1rem;
    }

    .quiz-card{
      background:#fff;
      border:1px solid var(--line);
      border-radius:18px;
      padding:1.1rem;
      box-shadow:var(--shadow-soft);
    }

    .quiz-card h5{
      margin:0 0 .7rem;
      color:var(--primary);
      font-size:1.12rem;
    }

    .quiz-card p{
      margin:0 0 .8rem;
      color:var(--muted);
      font-weight:700;
    }

    .quiz-btn{
      width:100%;
      border:none;
      background:linear-gradient(135deg,var(--green),#16a34a);
      color:#fff;
      border-radius:12px;
      padding:.78rem 1rem;
      font-weight:800;
      cursor:pointer;
    }

    .answer-box{
      display:none;
      background:#ecfdf5;
      border:1px solid rgba(34,197,94,.18);
      color:#166534;
      font-weight:700;
      border-radius:12px;
      padding:.8rem .9rem;
      margin-top:.8rem;
    }

    .cta{
      margin-top:2.5rem;
      background:linear-gradient(135deg, #0f172a 0%, #1d4ed8 50%, #0ea5e9 100%);
      border-radius:28px;
      padding:clamp(1.5rem,2vw,2.3rem);
      color:#fff;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:1rem;
      box-shadow:var(--shadow);
    }

    .cta h3{
      margin:0;
      font-size:clamp(1.5rem,2vw,2.2rem);
    }

    .cta p{
      margin:.25rem 0 0;
      opacity:.92;
    }

    footer{
      background:#0b1220;
      color:rgba(255,255,255,.9);
      text-align:center;
      padding:1.5rem 1rem;
      font-weight:700;
    }

    @media (max-width:900px){
      .hero-inner{grid-template-columns:1fr}
    }

    @media (max-width:640px){
      .nav{justify-content:center;text-align:center}
      .brand{width:100%;justify-content:center}
      .nav-menu{justify-content:center}
      .hero-actions{flex-direction:column;align-items:stretch}
      .btn{width:100%}
      .stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .cta{justify-content:center;text-align:center}
    }
  </style>
</head>
